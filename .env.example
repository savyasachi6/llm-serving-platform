# ==============================================================================
# Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env before starting the platform:
#   cp .env.example .env
#
# NOTE ON NETWORKING:
# - Host/Direct Python: Use http://localhost:<port>
# - Docker Compose:     Use http://<service_name>:<port> (e.g., http://vllm-responder:8080/v1)
# - Kubernetes:         Use http://<service_name>:<port> (e.g., http://gateway:80, http://agent-worker:8001)
# ==============================================================================

# --- API Gateway Settings ---
# Listening port for the FastAPI gateway server
GATEWAY_PORT=8000
# Logging verbosity (DEBUG, INFO, WARNING, ERROR)
GATEWAY_LOG_LEVEL=INFO
# Global HTTP request timeout in seconds
GATEWAY_TIMEOUT_SECONDS=120.0
# Global admission semaphore limit (prevents unbounded queue saturation)
GLOBAL_AGENT_CONCURRENCY=50
# Maximum concurrent requests per backend inference engine
PER_BACKEND_CONCURRENCY=20
# Maximum concurrent child tasks per single workflow/ticket
PER_WORKFLOW_CONCURRENCY=10
# Set to True to bypass inference engines with instantaneous in-memory mock responses
USE_MOCK=False

# --- Heterogeneous Dual-Engine vLLM Configuration ---
# 1. vllm-responder (High-Accuracy Synthesis & Reasoning Engine)
# In Docker Compose: http://vllm-responder:8080/v1
# In Local Dev:      http://localhost:8080/v1 (or 8082 if using root compose)
VLLM_RESPONDER_BASE_URL=http://localhost:8080/v1
VLLM_RESPONDER_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# 2. vllm-agents (High-Throughput Multi-LoRA Engine)
# In Docker Compose: http://vllm-agents:8080/v1
# In Local Dev:      http://localhost:8081/v1 (or 8083 if using root compose)
VLLM_AGENTS_BASE_URL=http://localhost:8081/v1
VLLM_AGENTS_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# LoRA adapter module identifiers registered on the vLLM agents node
VLLM_TRIAGE_LORA=reasoning-lora
VLLM_REDACT_LORA=reflection-lora

# Legacy fallback URL (used if workload_type does not match responder or agents)
VLLM_BASE_URL=http://localhost:8080/v1

# --- Hugging Face Authentication ---
# Required for downloading gated or private models/adapters from HuggingFace Hub
# NEVER commit real tokens to source control!
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=

# --- Fallback Inference Engine (Ollama CPU) ---
# Used for local CPU execution when no GPU is present (docker compose --profile local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct-q4_K_M

# --- In-Memory Cache (Redis) ---
# Exact-match caching database connection string. In Docker Compose: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# --- Observability ---
# Enable Prometheus metrics export at /metrics endpoint
ENABLE_METRICS=true
PROMETHEUS_PORT=9090

# --- Frontend Playground ---
# Target URL the browser connects to when executing the multi-agent pipeline
VITE_API_URL=http://localhost:8001
